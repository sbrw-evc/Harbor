# Harbor is set up in its setup wizard (open the panel in a browser after ./install.sh): the storage, the
# sign-in (local users or Keystone), the VPS, the router and the gateway. This file only feeds the bundled services.

# Passwords of the bundled PostgreSQL (TimescaleDB) and ClickHouse; install.sh generates them and prints them for the
# storage step of the wizard. The panel keeps them in OpenBao.
POSTGRES_PASSWORD=change-me
CLICKHOUSE_PASSWORD=change-me

# Optional.
NC_VERSION=2.0.0
PANEL_PORT=8080
FLOW_PORT=2055
SFLOW_PORT=6343
